#!/usr/bin/env sh

COMMIT_MSG_FILE="$1"

sed -i.bak \
  -e '/^Co-authored-by:.*[Cc]opilot/d' \
  -e '/^Co-authored-by:.*[Cc]laude/d' \
  -e '/^Co-authored-by:.*[Gg][Pp][Tt]/d' \
  -e '/^Co-authored-by:.*[Cc]hat[Gg][Pp][Tt]/d' \
  -e '/^Co-authored-by:.*[Gg]emini/d' \
  -e '/^Co-authored-by:.*[Cc]ursor/d' \
  -e '/^Co-authored-by:.*[Cc]odeium/d' \
  -e '/^Co-authored-by:.*[Tt]abnine/d' \
  -e '/^Co-authored-by:.*[Aa][Ii]\b/d' \
  "$COMMIT_MSG_FILE"

sed -i.bak \
  -e '/^🤖/d' \
  -e '/^Generated with/Id' \
  -e '/^Generated by/Id' \
  -e '/^AI-generated/Id' \
  "$COMMIT_MSG_FILE"

awk 'BEGIN{blank=0} /^[[:space:]]*$/{blank++; next} {for(i=0;i<blank;i++) print ""; blank=0; print}' \
  "$COMMIT_MSG_FILE" > "$COMMIT_MSG_FILE.tmp" && mv "$COMMIT_MSG_FILE.tmp" "$COMMIT_MSG_FILE"

rm -f "$COMMIT_MSG_FILE.bak"

node scripts/validate-commit-message.js "$COMMIT_MSG_FILE" || exit 1

exit 0
