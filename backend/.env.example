# Financial Modeling Prep (FMP) infrastructure configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Secret API key issued by FMP. Required — the client refuses to call without it.
FMP_API_KEY=

# Base URL for the FMP API. Defaults to the stable endpoint if unset.
FMP_BASE_URL=https://financialmodelingprep.com/stable

# Per-request timeout in milliseconds. Defaults to 10000 (10s) if unset.
FMP_TIMEOUT_MS=10000

# Minimum delay between FMP requests in milliseconds and the number of retry
# attempts on 429 responses. Defaults cushion batch jobs against provider rate
# limits from the shared HTTP client.
FMP_MIN_INTERVAL_MS=400
FMP_RATE_LIMIT_RETRIES=4
    
# Alpaca paper
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_API_BASE_URL=https://paper-api.alpaca.markets

# Alpaca live
ALPACA_LIVE_ENABLED=false
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_LIVE_API_BASE_URL=https://api.alpaca.markets
LIVE_TRADE_PASSPHRASE=

# Automated investment batch runner
MAX_TRADE_AMOUNT=
TICKER_SOURCE_DIRECTORY=./data/tickers
AUTOMATED_INVESTMENT_DECISIONS_FILE=./data/decisions.json

# Internal cron runner
AUTOMATION_CRON_ENABLED=false
AUTOMATION_CRON_INTERVAL_MS=86400000
AUTOMATION_CRON_INITIAL_DELAY_MS=60000
INTERNAL_API_BASE_URL=http://127.0.0.1:3001
AUTOMATION_RUN_PASSPHRASE=