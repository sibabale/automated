# Financial Modeling Prep (FMP) infrastructure configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Secret API key issued by FMP. Required — the client refuses to call without it.
FMP_API_KEY=

# Base URL for the FMP API. Defaults to the stable endpoint if unset.
FMP_BASE_URL=https://financialmodelingprep.com/stable

# Per-request timeout in milliseconds. Defaults to 10000 (10s) if unset.
FMP_TIMEOUT_MS=10000
    
# Alpaca paper
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_API_BASE_URL=https://paper-api.alpaca.markets

# Alpaca live
ALPACA_LIVE_ENABLED=false
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_LIVE_API_BASE_URL=https://api.alpaca.markets
LIVE_TRADE_PASSPHRASE=