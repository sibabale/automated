{
  "reporter": ["text", "text-summary", "html", "lcov"],
  "reports-dir": "./coverage",
  "all": true,
  "src": ["./src"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/server.ts",
    "src/types/**",
    "src/domain/entities/financial-year.entity.ts",
    "src/domain/entities/cash-flow-year.entity.ts",
    "src/domain/entities/debt-to-equity-year.entity.ts",
    "src/domain/entities/margin-of-safety-year.entity.ts",
    "src/domain/entities/profit-margin-year.entity.ts",
    "src/domain/repositories/financial-data.repository.ts",
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "templates/**"
  ],
  "extension": [".ts", ".js"],
  "check-coverage": true,
  "lines": 100,
  "functions": 100,
  "branches": 100,
  "statements": 100,
  "exclude-node-modules": true
}
